{
  "base_model": "google/gemma-4-E4B-it",
  "domain": "coding",
  "train_path": "data/processed/domain_train.jsonl",
  "valid_path": "data/processed/domain_valid.jsonl",
  "output_dir": "artifacts/gemma4e4b-coding-qlora-smoke",
  "max_seq_length": 256,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 2,
  "learning_rate": 0.0002,
  "num_train_epochs": 1,
  "max_steps": 1,
  "logging_steps": 1,
  "save_steps": 1,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "load_in_4bit": true,
  "torch_dtype": "bfloat16"
}